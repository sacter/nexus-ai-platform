# ===========================================
# Docker 基础设施
# ===========================================

# PostgreSQL
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus123
POSTGRES_DB=nexus
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_DIR=minio_data

# ===========================================
# 应用连接（基于上面的基础设施）
# ===========================================

# PostgreSQL - 应用连接 URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# MinIO - 应用连接
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_USE_SSL=false

# API
PORT=3000

# ===========================================
# 安全
# ===========================================

# JWT 签名密钥（必填，生产环境使用随机强密码）
JWT_SECRET=change-me-to-a-random-secret

# RSA-2048 密钥对（PEM 格式，\n 表示换行）
# 留空则启动时自动生成（开发环境可省略，生产环境必须设置以保持重启后一致）
# 生成方式: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#          openssl rsa -pubout -in private.pem -out public.pem
# 将文件内容转为单行（\n 替代换行）填入下方
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# AES 加密密钥
AES_ENCRYPTION_KEY=""

# ===========================================
# Embedding 模型（统一模型提供文件读取）
# ===========================================
EMBEDDING_DEFAULT_PROVIDER=ollama
EMBEDDING_DEFAULT_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# BGE Reranker (Infinity)
# 默认使用 bge-reranker-base（CPU 推理快）；可切换为 BAAI/bge-reranker-v2-m3 提升精度
# 注意：Infinity 按精确 model id 路由，必须填完整 ID（短名会返回 400）
BGE_RERANKER_BASE_URL=http://localhost:8000
BGE_RERANKER_MODEL=BAAI/bge-reranker-base
