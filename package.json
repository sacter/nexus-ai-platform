{
  "name": "NexusAI Platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "commit": "cz"
  },
  "devDependencies": {
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
